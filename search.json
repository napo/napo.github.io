---
layout: null
permalink: /search.json
---
[
  {% assign articles = site.posts | sort: "date" | reverse %}
  {% for article in articles %}
  {
    "title": {{ article.title | jsonify }},
    "url": {{ article.url | relative_url | jsonify }},
    "date": {{ article.date | date: "%d/%m/%Y" | jsonify }},
    "content": {{ article.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
